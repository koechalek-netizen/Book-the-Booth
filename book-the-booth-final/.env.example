# Copy this file to .env and fill in real values. .env itself is git-ignored.

DATABASE_URI=postgresql://<user>:<password>@localhost:5432/book_the_booth
SECRET_KEY=replace-with-output-of: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-different-output-of-the-same-command
